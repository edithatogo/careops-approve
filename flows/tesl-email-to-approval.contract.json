{
  "name": "CareOps TESL Email to Approval",
  "status": "blueprint",
  "surfaces": ["Office 365 Outlook", "SharePoint", "Power Automate", "Teams Approvals"],
  "templateRef": "config/approval-templates.example.json",
  "roleAssignments": "config/role-assignments.example.json",
  "notificationPolicy": {
    "approvalEmail": false,
    "outboundEmail": false,
    "teamsSurface": true,
    "sharePointStatus": true
  },
  "postApprovalExecution": "config/desktop-intranet-execution.example.json",
  "reusePatterns": "config/power-automate-reuse.example.json",
  "trigger": {
    "type": "outlook-email-arrival",
    "operation": "When a new email arrives (V3)",
    "configuration": "tenant-provided mailbox, folder, sender allow-list, and subject marker",
    "inputs": ["messageId", "from", "receivedAt", "subject", "bodyPreview", "webLink", "attachments"]
  },
  "steps": [
    { "id": "match-tesl-email", "type": "subject-sender-folder-filter", "onFailure": "ignore-non-tesl-email" },
    { "id": "parse-tesl-details", "type": "alias-aware-header-and-body-parser", "mapping": "config/tesl-email-mapping.example.json", "onFailure": "preserve-and-alert-owner" },
    { "id": "load-template", "type": "resolve-template-by-source-and-category", "onFailure": "preserve-and-alert-owner" },
    { "id": "validate-tesl-details", "type": "require-tesl-id-title-status-summary", "onFailure": "preserve-and-alert-owner" },
    { "id": "load-configuration", "type": "sharepoint-read-active-approver", "onFailure": "preserve-and-alert-owner" },
    { "id": "resolve-roster-and-delegation", "type": "sharepoint-roster-exception-and-delegate-resolution", "onFailure": "preserve-and-alert-owner" },
    { "id": "generate-request-id", "type": "idempotent-request-id" },
    { "id": "create-submission", "type": "sharepoint-create-item", "status": "Submitted", "immutable": ["requestId", "assignedApproverEmail", "approverConfigurationVersion", "sourceMessageId", "teslId"] },
    { "id": "create-approval", "type": "native-teams-approval", "responses": ["Approve", "Reject"], "assignedTo": "resolved-primary-or-fallback", "sendEmailNotification": false, "title": "TESL: teslTitle", "details": ["teslId", "teslStatus", "teslCategory", "teslOwner", "teslDueDate", "teslPriority", "teslSummary", "teslLink", "email.webLink"] },
    { "id": "present-teams-card", "type": "teams-adaptive-card-presentation", "authoritativeDecisionSource": "native-teams-approval", "email": false },
    { "id": "wait-for-decision", "type": "wait-for-approval-or-14-day-timeout" },
    { "id": "check-still-pending", "type": "re-read-submission-and-approval-status" },
    { "id": "create-edms-escalation", "type": "native-teams-approval", "when": "still-pending-after-14-days", "assignedTo": "edmsEscalationApprover", "sendEmailNotification": false, "title": "EDMS escalation: teslTitle", "details": ["requestId", "teslId", "escalationReason", "sourceLink"] },
    { "id": "wait-for-edms-decision", "type": "start-and-wait-for-an-approval", "when": "edms-escalation-created" },
    { "id": "record-verbal-delegation", "type": "sharepoint-create-delegation-record", "when": "urgent-delegate-responds", "required": ["delegator", "delegate", "delegationReason", "delegatedAt", "requestId"], "notify": "workflowOwner" },
    { "id": "persist-outcome", "type": "sharepoint-create-decision", "immutable": ["requestId", "approvalId", "assignedApproverEmail", "outcome", "decidedAt"] },
    { "id": "notify-requester", "type": "teams-post-and-sharepoint-status", "contains": ["requestId", "teslId", "outcome", "decisionComment", "approvalLink"], "email": false },
    { "id": "run-desktop-intranet", "type": "power-automate-desktop-flow", "when": "outcome-equals-approved", "config": "config/desktop-intranet-execution.example.json", "email": false },
    { "id": "build-weekly-owner-summary", "type": "scheduled-sharepoint-query-and-teams-post", "visibility": "workflowOwner", "email": false, "states": ["Submitted", "Pending", "Overdue", "Escalated", "Failed", "UrgentDelegation"] },
    { "id": "finalize", "type": "decision-persistence", "onDuplicate": "retain-first-final-outcome" }
  ],
  "failurePaths": [
    "non-tesl-email-is-ignored",
    "invalid-tesl-details-preserves-email-and-alerts-owner",
    "invalid-configuration-preserves-submission-and-alerts-owner",
    "connector-failure-preserves-request-and-reports-actionable-error",
    "duplicate-message-does-not-create-second-approval",
    "pending-approval-escalates-to-edms-after-14-days",
    "urgent-delegation-requires-auditable-verbal-delegation-record",
    "approved-outcome-runs-intranet-stage-only",
    "no-outbound-email-notifications",
    "adaptive-card-does-not-replace-native-approval-record",
    "weekly-summary-is-owner-only"
  ],
  "tenantConfiguration": "not stored in source control"
}
