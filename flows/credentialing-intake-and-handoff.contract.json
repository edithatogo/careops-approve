{
  "name": "Credentialing intake and governed handoff",
  "contractVersion": "0.1.0",
  "status": "blueprint-disabled-by-default",
  "capabilityPack": "credentialing-intake",
  "decisionAuthority": "deployment-defined-human-delegate",
  "surfaces": [
    "approved-intake-surface",
    "SharePoint-or-Dataverse",
    "Power Automate",
    "Microsoft Teams",
    "approved-records-environment"
  ],
  "steps": [
    {
      "id": "receive-request",
      "type": "approved-intake-trigger",
      "inputs": [
        "sourceReference",
        "requesterReference",
        "practitionerReference",
        "requestedPathway",
        "requestedScopeReference",
        "facilityOrServiceReferences",
        "evidenceManifestReference"
      ]
    },
    {
      "id": "deduplicate-request",
      "type": "idempotency-check",
      "key": [
        "sourceReference",
        "practitionerReference",
        "requestedPathway",
        "requestedScopeReference"
      ],
      "onDuplicate": "link-to-existing-request-and-do-not-create-second-case"
    },
    {
      "id": "load-deployment-profile",
      "type": "configuration-read",
      "requires": [
        "active-template-version",
        "approved-authority-mapping",
        "role-assignments",
        "classification-policy",
        "records-location",
        "feature-flags"
      ],
      "onFailure": "preserve-request-and-route-to-owner"
    },
    {
      "id": "confirm-pathway",
      "type": "deterministic-and-human-confirmed-classification",
      "automaticAdverseEffect": false,
      "onUncertain": "credentialing-officer-review"
    },
    {
      "id": "validate-required-data",
      "type": "deterministic-validation",
      "rulesFrom": "active-template-and-authority-mapping",
      "onFailure": "correction-queue",
      "aiIndependent": true
    },
    {
      "id": "run-optional-document-triage",
      "type": "approved-ocr-nlp-or-llm-assistance",
      "enabledByFeatureFlag": "ai-evidence-triage",
      "authoritative": false,
      "requiresSourceSpans": true,
      "requiresConfidence": true,
      "requiresModelAndPromptVersion": true,
      "onFailure": "continue-to-ordinary-human-review"
    },
    {
      "id": "persist-triage-assessment",
      "type": "advisory-assessment-record",
      "contains": [
        "sourceDocumentReferences",
        "extractedFields",
        "sourceSpans",
        "missingInformation",
        "contradictions",
        "confidence",
        "providerModel",
        "promptOrAgentVersion",
        "evaluatedAt",
        "inputHash",
        "outputHash",
        "humanReviewRequired"
      ],
      "canModifySourceEvidence": false
    },
    {
      "id": "credentialing-officer-review",
      "type": "mandatory-human-review",
      "outcomes": [
        "return-for-correction",
        "request-further-information",
        "ready-for-professional-review",
        "ready-for-committee-handoff",
        "refer-exception"
      ],
      "requiresReviewerAndTimestamp": true
    },
    {
      "id": "professional-and-service-review",
      "type": "deployment-defined-human-review",
      "when": "required-by-pathway-or-policy",
      "mayInclude": [
        "relevant-peer-assessment",
        "service-capability-attestation",
        "supervision-proposal",
        "conditions-proposal"
      ],
      "canFinalizeDecision": false
    },
    {
      "id": "build-governance-packet",
      "type": "immutable-handoff-packet",
      "targetContract": "careops-decisions-credentialing",
      "contains": [
        "requestId",
        "templateVersion",
        "authorityMappingVersion",
        "pathway",
        "requestedScopeReference",
        "facilityOrServiceReferences",
        "evidenceManifestReference",
        "verificationSummary",
        "professionalReviewReferences",
        "proceduralFairnessStatus",
        "exceptions",
        "packetHash"
      ],
      "excludes": [
        "unapproved-ai-conclusions",
        "raw-sensitive-telemetry"
      ]
    },
    {
      "id": "handoff-to-governance",
      "type": "careops-decisions-contract",
      "humanRecommendationRequired": true,
      "humanDelegatedDecisionRequired": true,
      "automaticApprovalPermitted": false
    },
    {
      "id": "receive-governance-result-reference",
      "type": "immutable-result-reference",
      "requires": [
        "recommendationReference",
        "decisionReference",
        "decisionMakerAuthorityReference",
        "decisionTimestamp",
        "conditionsOrSupervisionReferences",
        "expiryDate",
        "decisionHash"
      ],
      "doesNotReplaceAuthoritativeDecisionRecord": true
    },
    {
      "id": "release-and-register-gate",
      "type": "separate-controlled-integration",
      "enabledByFeatureFlag": "credentialing-release-integration",
      "requires": [
        "approved-decision-reference",
        "authoritative-register-target",
        "reconciliation-plan",
        "rollback-plan",
        "operational-owner"
      ],
      "disabledForInitialMvp": true
    },
    {
      "id": "emit-process-events",
      "type": "privacy-minimised-event-projection",
      "enabledByFeatureFlag": "credentialing-process-events",
      "targetContract": "careops-process-credentialing",
      "rawDocuments": false,
      "freeText": false
    },
    {
      "id": "finalize",
      "type": "audit-and-status-persistence",
      "retainFirstFinalOutcome": true,
      "requiresReconciliationStatus": true
    }
  ],
  "failurePaths": [
    "missing-profile-preserves-request",
    "invalid-data-does-not-create-governance-handoff",
    "duplicate-does-not-create-second-case",
    "ai-failure-preserves-human-path",
    "ai-output-never-finalizes-decision",
    "missing-human-review-blocks-handoff",
    "missing-delegated-authority-blocks-release",
    "failed-integration-does-not-change-authoritative-record",
    "all-exceptions-remain-visible-and-recoverable"
  ],
  "deploymentConfiguration": "Policy mappings, identities, connectors, records locations, SLAs, durations, and authoritative systems are deployment-specific and excluded from source control."
}
