{
  "name": "CareOps Submit and Route",
  "status": "blueprint",
  "surfaces": ["Microsoft Forms", "SharePoint", "Power Automate", "Teams Approvals"],
  "trigger": {
    "type": "forms-response",
    "configuration": "tenant-provided form identifier",
    "inputs": ["title", "description", "supportingUrl", "requesterEmail"]
  },
  "steps": [
    { "id": "validate-input", "type": "validation", "onFailure": "acknowledge-invalid-submission" },
    { "id": "load-configuration", "type": "sharepoint-read-active-approver", "onFailure": "preserve-and-alert-owner" },
    { "id": "generate-request-id", "type": "idempotent-request-id" },
    { "id": "create-submission", "type": "sharepoint-create-item", "status": "Submitted", "immutable": ["requestId", "assignedApproverEmail", "approverConfigurationVersion"] },
    { "id": "create-approval", "type": "native-teams-approval", "responses": ["Approve", "Reject"], "assignedTo": "resolved-primary-or-fallback" },
    { "id": "acknowledge-requester", "type": "notification", "contains": ["requestId", "assignedApprover"] },
    { "id": "finalize", "type": "decision-persistence", "onDuplicate": "retain-first-final-outcome" }
  ],
  "failurePaths": [
    "invalid-input-does-not-create-approval",
    "invalid-configuration-preserves-submission-and-alerts-owner",
    "connector-failure-preserves-request-and-reports-actionable-error"
  ],
  "tenantConfiguration": "not stored in source control"
}
