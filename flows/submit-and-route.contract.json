{
  "name": "CareOps Submit and Route",
  "status": "blueprint",
  "surfaces": ["Microsoft Forms", "Office 365 Outlook", "SharePoint", "Power Automate", "Teams Approvals"],
  "trigger": {
    "type": "forms-response",
    "configuration": "tenant-provided form identifier",
    "inputs": ["title", "description", "supportingUrl", "requesterEmail", "sourceMessageId", "teslDetails"]
  },
  "steps": [
    { "id": "validate-input", "type": "validation", "onFailure": "acknowledge-invalid-submission" },
    { "id": "load-configuration", "type": "sharepoint-read-active-approver", "onFailure": "preserve-and-alert-owner" },
    { "id": "generate-request-id", "type": "idempotent-request-id" },
    { "id": "create-submission", "type": "sharepoint-create-item", "status": "Submitted", "immutable": ["requestId", "assignedApproverEmail", "approverConfigurationVersion"] },
    { "id": "create-approval", "type": "native-teams-approval", "responses": ["Approve", "Reject"], "assignedTo": "resolved-primary-or-fallback", "sendEmailNotification": false, "rejectionRequiresComment": true, "timeoutDays": 14, "onTimeout": "create-edms-escalation" },
    { "id": "acknowledge-requester", "type": "notification", "surface": "teams-or-sharepoint", "email": false, "contains": ["requestId", "assignedApprover"] },
    { "id": "restrict-request-visibility", "type": "authorization", "audience": ["workflowOwner", "requester", "assignedApprover"], "excludeFromAudience": ["unassignedUsers", "generalTeamMembers"], "email": false },
    { "id": "persist-immutable-assignment", "type": "decision-persistence", "immutable": ["requestId", "assignedApproverEmail", "approverConfigurationVersion", "approvalId"] },
    { "id": "persist-final-outcome", "type": "decision-persistence", "requires": ["outcome", "decidedAt", "decisionComment"], "onDuplicate": "retain-first-final-outcome" },
    { "id": "allow-requester-cancellation", "type": "controlled-cancellation", "allowedBefore": "final-outcome", "requires": ["requesterIdentity", "cancellationReason"], "onDuplicate": "retain-first-final-outcome" },
    { "id": "create-edms-escalation", "type": "native-teams-approval", "assignedTo": "resolved-edms-escalation-approver", "sendEmailNotification": false, "requires": ["timeoutAt", "escalationReason", "priorApprovalId"] },
    { "id": "finalize", "type": "decision-persistence", "onDuplicate": "retain-first-final-outcome" }
  ],
  "failurePaths": [
    "invalid-input-does-not-create-approval",
    "invalid-configuration-preserves-submission-and-alerts-owner",
    "connector-failure-preserves-request-and-reports-actionable-error",
    "rejection-without-comment-does-not-finalize",
    "assigned-approver-and-approval-id-are-immutable",
    "timeout-escalates-to-edms-without-email",
    "requester-cancellation-is-audited-and-idempotent",
    "visibility-is-limited-to-owner-requester-and-assigned-approver"
  ],
  "tenantConfiguration": "not stored in source control"
}
