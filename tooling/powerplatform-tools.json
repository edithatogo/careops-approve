{
  "schemaVersion": 1,
  "installMode": "user-local",
  "tools": {
    "dotnetSdk": {"version": "10.0.301", "installRoot": "%USERPROFILE%\\scoop\\apps\\dotnet-sdk\\current"},
    "dotnetRuntime": {"version": "8.0.28", "installRoot": "%USERPROFILE%\\.dotnet\\runtime8"},
    "pac": {"package": "Microsoft.PowerApps.CLI.Tool", "version": "2.9.3", "executable": "pac.exe", "runtime": "dotnetSdk"},
    "pacx": {"package": "Greg.Xrm.Command", "version": "1.2026.6.220", "executable": "pacx.exe", "runtime": "dotnetRuntime"},
    "pacxFork": {"repository": "https://github.com/edithatogo/pacx.git", "branch": "codex/pacx-bearer-auth-20260714", "sourceCommit": "f41168dad193f3b7b51a386e313e8d1d1a6e40ed", "preferredTargetFramework": "net11.0", "fallbackTargetFramework": "net10.0", "buildProject": "Greg.Xrm.Command/Greg.Xrm.Command/Greg.Xrm.Command.csproj", "installRoot": "%LOCALAPPDATA%\\CareOps\\pacx", "buildGuide": "tooling/pacx-fork-build.md"}
