{
  "schemaVersion": 1,
  "status": "example",
  "catalogVersion": "0.1.0",
  "domain": "credentialing-and-scope",
  "decisionAuthority": "deployment-defined-human-delegate",
  "templates": [
    {
      "templateId": "credentialing-routine-renewal",
      "version": "0.1.0",
      "status": "mvp-candidate",
      "displayName": "Routine credentialing and scope renewal",
      "pathwayClass": "renewal",
      "eligibleSubmitterRoles": [
        "requester",
        "operationalCoordinator",
        "authorisedEditor"
      ],
      "requiredFields": [
        "practitionerReference",
        "profession",
        "currentApprovalReference",
        "currentExpiryDate",
        "requestedScopeReference",
        "facilityOrServiceReferences",
        "declarationCompleted",
        "evidenceManifestReference"
      ],
      "deterministicChecks": [
        "required-fields-present",
        "current-approval-reference-present",
        "expiry-date-valid",
        "evidence-manifest-complete-for-approved-profile",
        "requested-scope-has-stable-identifier",
        "facility-or-service-identified",
        "duplicate-active-request-not-present"
      ],
      "humanStages": [
        "credentialing-officer-completeness-review",
        "relevant-peer-or-service-review-where-required",
        "committee-recommendation-or-approved-equivalent",
        "delegated-decision",
        "register-and-release-control"
      ],
      "aiUse": {
        "allowed": [
          "document-classification",
          "field-extraction",
          "missing-information-summary",
          "evidence-pack-summary",
          "draft-correspondence"
        ],
        "prohibited": [
          "identity-verification",
          "registration-verification",
          "competence-determination",
          "scope-determination",
          "approval-or-refusal",
          "condition-or-supervision-decision",
          "release-to-practise"
        ],
        "humanReviewRequired": true
      }
    },
    {
      "templateId": "credentialing-changed-scope",
      "version": "0.1.0",
      "status": "future-pack",
      "displayName": "Additional or changed scope",
      "pathwayClass": "changed-scope",
      "inherits": "credentialing-routine-renewal",
      "additionalRequiredFields": [
        "changeDescription",
        "newTrainingOrQualificationEvidence",
        "recentActivityOrCurrencyEvidence",
        "serviceCapabilityAttestation",
        "peerAssessmentReferences"
      ]
    },
    {
      "templateId": "credentialing-mutual-recognition",
      "version": "0.1.0",
      "status": "future-pack",
      "displayName": "Mutual recognition",
      "pathwayClass": "mutual-recognition",
      "additionalRequiredFields": [
        "primaryOrganisation",
        "primaryApprovalReference",
        "primaryApprovalExpiryDate",
        "primaryEvidenceManifestReference",
        "localFacilityCapabilityAttestation"
      ]
    },
    {
      "templateId": "credentialing-temporary-pathway",
      "version": "0.1.0",
      "status": "future-high-risk-pack",
      "displayName": "Interim, emergency, or disaster pathway",
      "pathwayClass": "temporary",
      "requiresSeparatePathwaySubtype": true,
      "requiresExplicitDelegatedAuthority": true,
      "hardExpiryRequired": true,
      "retrospectiveReviewRequired": true,
      "automaticApprovalPermitted": false
    }
  ],
  "authorityMapping": "The deployment profile must map each field, check, stage, duration, and decision role to current controlling sources. Example templates are not themselves policy.",
  "tenantConfiguration": "No practitioner identifiers, policy conclusions, approver identities, or tenant values are stored in this example."
}
