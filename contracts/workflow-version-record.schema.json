{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careops.example/schemas/workflow-version-record.schema.json",
  "title": "CareOps workflow version record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "version",
    "state",
    "definitionHash",
    "etag",
    "revision",
    "definition"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "state": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    },
    "definitionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "etag": {
      "type": "string",
      "pattern": "^\\\"[1-9][0-9]*-[0-9a-f]{16}\\\"$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "definition": {
      "$ref": "./workflow-definition.schema.json"
    }
  }
}
