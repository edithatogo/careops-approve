{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://careops.example/schemas/case.schema.json",
  "title":"CareOps case",
  "type":"object",
  "additionalProperties":false,
  "required":["caseId","workflowId","workflowVersion","revision","currentNodeId","status"],
  "properties":{
    "caseId":{"type":"string","pattern":"^CA-[0-9A-Z-]{8,64}$"},
    "workflowId":{"type":"string","pattern":"^[a-z][a-z0-9.-]{2,127}$"},
    "workflowVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "revision":{"type":"string","minLength":1,"maxLength":100},
    "currentNodeId":{"type":["string","null"],"maxLength":100},
    "status":{"enum":["running","waiting-human","completed","failed","cancelled"]}
  }
}
