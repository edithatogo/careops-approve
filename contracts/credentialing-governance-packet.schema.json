{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-approve/contracts/credentialing-governance-packet.schema.json",
  "title": "CareOps credentialing governance packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "practitionerReference",
    "pathwayCode",
    "requestedScopeReferences",
    "facilityOrServiceReferences",
    "templateVersion",
    "authorityMappingVersion",
    "evidenceManifestReference",
    "verificationSummaryReference",
    "proceduralFairnessStatus",
    "sourcePacketHash"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "practitionerReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Approved source-local or pseudonymous reference, not a practitioner name or registration number."
    },
    "pathwayCode": {
      "enum": [
        "routine-renewal",
        "new-application",
        "changed-scope",
        "mutual-recognition",
        "interim",
        "emergency",
        "disaster",
        "review",
        "appeal"
      ]
    },
    "requestedScopeReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "facilityOrServiceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "authorityMappingVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evidenceManifestReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationSummaryReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "proceduralFairnessStatus": {
      "enum": [
        "not-required",
        "not-started",
        "notice-issued",
        "response-received",
        "response-considered",
        "complete"
      ]
    },
    "sourcePacketHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "temporaryApprovalExpiry": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "caseClassification": {
      "type": "string",
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pathwayCode": {
            "enum": [
              "interim",
              "emergency",
              "disaster"
            ]
          }
        },
        "required": [
          "pathwayCode"
        ]
      },
      "then": {
        "required": [
          "temporaryApprovalExpiry"
        ],
        "properties": {
          "temporaryApprovalExpiry": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
