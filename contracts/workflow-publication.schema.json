{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careops.example/schemas/workflow-publication.schema.json",
  "title": "CareOps workflow publication request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "version",
    "definitionHash",
    "requestedByRole",
    "validationStatus",
    "testStatus",
    "governanceStatus",
    "requestedAction",
    "migrationPolicy"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "definitionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requestedByRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "validationStatus": {
      "const": "passed"
    },
    "testStatus": {
      "const": "passed"
    },
    "governanceStatus": {
      "enum": [
        "not-required",
        "approved"
      ]
    },
    "requestedAction": {
      "enum": [
        "publish",
        "retire"
      ]
    },
    "supersedesVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "migrationPolicy": {
      "enum": [
        "no-running-case-migration",
        "explicit-reviewed-migration"
      ]
    }
  }
}
