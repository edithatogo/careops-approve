{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careops.example/schemas/workflow-trusted-bindings.schema.json",
  "title": "CareOps trusted workflow binding catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roles",
    "agents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roleKey"
        ],
        "properties": {
          "roleKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "version"
        ],
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    }
  }
}
