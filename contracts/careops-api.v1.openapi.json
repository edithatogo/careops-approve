{
  "openapi": "3.1.0",
  "info": {
    "title": "CareOps Approve API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/cases": {
      "post": {
        "summary": "Create a case from an active workflow version",
        "operationId": "createCase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "workflowId",
                  "workflowVersion",
                  "caseId",
                  "revision"
                ],
                "properties": {
                  "workflowId": {
                    "type": "string"
                  },
                  "workflowVersion": {
                    "type": "string"
                  },
                  "caseId": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Case created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./case.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{caseId}": {
      "get": {
        "summary": "Get permitted case state",
        "operationId": "getCase",
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Case state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./case.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}/actions": {
      "post": {
        "summary": "Complete an assigned human task",
        "operationId": "completeTask",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "complete",
                      "approve",
                      "reject",
                      "return-for-correction"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated case",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./case.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{caseId}/events": {
      "get": {
        "summary": "List privacy-filtered workflow events",
        "operationId": "listCaseEvents",
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./workflow-event.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflow-studio/node-types": {
      "get": {
        "summary": "List node types and editor metadata permitted for the caller",
        "operationId": "listWorkflowNodeTypes",
        "responses": {
          "200": {
            "description": "Workflow Studio node catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./workflow-editor-catalog.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows/{workflowId}/versions/{version}": {
      "put": {
        "summary": "Save a draft workflow definition",
        "operationId": "saveWorkflowDraft",
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./workflow-definition.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft saved"
          }
        }
      }
    },
    "/api/v1/workflows/{workflowId}/versions/{version}/validate": {
      "post": {
        "summary": "Validate a draft workflow definition without publishing it",
        "operationId": "validateWorkflowDraft",
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/api/v1/workflows/{workflowId}/versions/{version}/publication-requests": {
      "post": {
        "summary": "Submit a validated workflow version for publication or retirement",
        "operationId": "requestWorkflowPublication",
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./workflow-publication.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Publication request accepted for governed processing"
          }
        }
      }
    }
  }
}
