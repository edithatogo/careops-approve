{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careops.example/schemas/workflow-validation-result.schema.json",
  "title": "CareOps workflow validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "version",
    "definitionHash",
    "deployable",
    "errors"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "definitionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deployable": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployable": {
            "const": true
          }
        },
        "required": [
          "deployable"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployable": {
            "const": false
          }
        },
        "required": [
          "deployable"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
