{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/careops-approve/contracts/credentialing-result.schema.json",
  "title": "CareOps credentialing decision result reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "recommendationId",
    "decisionId",
    "decisionMakerReference",
    "delegationAuthorityReference",
    "humanDecisionConfirmed",
    "outcomeCode",
    "approvedScopeReferences",
    "commencementDate",
    "expiryDate",
    "decisionHash",
    "authoritativeRegisterUpdated",
    "releaseToPractiseConfirmed"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recommendationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decisionMakerReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "delegationAuthorityReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "humanDecisionConfirmed": {
      "const": true
    },
    "outcomeCode": {
      "enum": [
        "approved",
        "approved-with-conditions",
        "part-approved",
        "deferred",
        "not-approved",
        "withdrawn"
      ]
    },
    "approvedScopeReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "conditionReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "supervisionPlanReference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "commencementDate": {
      "type": "string",
      "format": "date"
    },
    "expiryDate": {
      "type": "string",
      "format": "date"
    },
    "communicationReference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "decisionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authoritativeRegisterUpdated": {
      "const": false
    },
    "releaseToPractiseConfirmed": {
      "const": false
    }
  }
}
